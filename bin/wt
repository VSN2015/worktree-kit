#!/bin/sh
# wt — run commands and servers for git worktrees, per-worktree isolated.
#
# A worktree-aware runner: every git worktree of a repo can run one-off
# commands and its own app server, with optional per-worktree isolation
# (own Redis DB number, own database) declared per repo in worktree-kit.yml.
# Stack-agnostic: the core only executes commands the config declares.
#
# Dependencies: git, plus one YAML reader — yq (v4), ruby, or python3 with
# PyYAML (auto-detected; macOS ships ruby, so usually nothing to install).
# The reader only runs when the config changes: parsed config is cached as
# shell assignments under <git-common>/wt-state/ and sourced on every run.
# docker compose only for `runner: compose` repos.
set -eu

WT_VERSION="0.1.8"

die() { echo "wt: $*" >&2; exit 1; }
note() { echo "wt: $*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# ---------- context ----------

hashnum() { printf '%s' "$1" | cksum | cut -d' ' -f1; }

# Slugs feed database names like wt_{slug}_test, and identifiers are capped
# at 63 chars in postgres / 64 in mysql. Long slugs are cut to a 29-char
# prefix + cksum of the full name (40 chars max), so any worktree name fits
# with room for template prefixes, and truncated slugs stay unique.
slugify() {
  _s="$(basename "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '_' | sed 's/_*$//')"
  if [ "${#_s}" -gt 40 ]; then
    _s="$(printf '%s' "$_s" | cut -c1-29 | sed 's/_*$//')_$(hashnum "$_s")"
  fi
  printf '%s\n' "$_s"
}

ctx_init() {
  need git
  WT_PATH="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repository"
  GIT_COMMON="$(git rev-parse --path-format=absolute --git-common-dir)"
  PRIMARY="$(dirname "$GIT_COMMON")"
  CONFIG="$PRIMARY/worktree-kit.yml"
  LOCAL_CONFIG="$PRIMARY/worktree-kit.local.yml"
  PROJECT="$(slugify "$PRIMARY")"
  SLUG="$(slugify "$WT_PATH")"
  N=$(( $(hashnum "$SLUG") % 15 + 1 ))
  STATE_DIR="$GIT_COMMON/wt-state"
  OVERLAY_DIR="$GIT_COMMON/local"
  mkdir -p "$STATE_DIR/logs"
}

load_config_soft() {
  if [ -f "$CONFIG" ]; then
    HAS_CONFIG=1
    load_config
    RUNNER="$(cfg_get runner compose)"
    SERVICE="$(cfg_get compose.service app)"
    WORKDIR="$(cfg_get compose.workdir /app)"
    CONTAINER_PORT="$(cfg_get hooks.container_port 3000)"
    PREPARE="$(cfg_get hooks.prepare "")"
    BUILD="$(cfg_get hooks.build "")"
    SERVER_CMD="$(cfg_get hooks.server "")"
  else
    HAS_CONFIG=0
    RUNNER=""; SERVICE=""; WORKDIR=""; CONTAINER_PORT=3000
    PREPARE=""; BUILD=""; SERVER_CMD=""
  fi
}

require_config() {
  load_config_soft
  if [ "$HAS_CONFIG" = 0 ]; then
    die "no worktree-kit.yml at $PRIMARY — run 'wt init' in that repo"
  fi
  if [ "$RUNNER" = compose ]; then need docker; fi
}

# ---------- yaml backend ----------
# wt needs a YAML reader only to (re)build the config cache: yq if present,
# else ruby (ships with macOS), else python3 + PyYAML. Every lookup after
# that is pure shell — the hot path spawns no interpreter at all.

yaml_backend() {
  if command -v yq >/dev/null 2>&1; then YAML_BACKEND=yq
  elif command -v ruby >/dev/null 2>&1; then YAML_BACKEND=ruby
  elif command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' >/dev/null 2>&1; then YAML_BACKEND=python
  else YAML_BACKEND=""
  fi
}

# Each dumper flattens one whole YAML file into shell assignments, depth-first:
#   scalar at a.b -> PREFIX_a_b='value'          (null values are skipped)
#   map at a      -> PREFIX_a__keys='k1<NL>k2'   plus one entry per key
#   list at a     -> PREFIX_a__len=N             plus PREFIX_a_0, PREFIX_a_1...
# Path segments are sanitized [^A-Za-z0-9] -> _ (cfg_var mirrors this).
# The ruby/python sources build quote/backslash/newline from char codes
# (39/92/10) so the scripts can live inside single-quoted sh strings.

WT_DUMP_RB='
require "yaml"
file, prefix = ARGV
s = File.read(file)
doc = (YAML.respond_to?(:unsafe_load) ? YAML.unsafe_load(s) : YAML.load(s)) || {}
Q = 39.chr
def shq(v) Q + v.to_s.gsub(Q) { Q + 92.chr + Q + Q } + Q end
def san(k) k.to_s.gsub(/[^A-Za-z0-9]/, "_") end
def emit(n, var)
  case n
  when Hash
    puts "#{var}__keys=#{shq(n.keys.join(10.chr))}" unless n.empty?
    n.each { |k, v| emit(v, "#{var}_#{san(k)}") }
  when Array
    puts "#{var}__len=#{n.length}"
    n.each_with_index { |v, i| emit(v, "#{var}_#{i}") }
  when nil
  else
    puts "#{var}=#{shq(n)}"
  end
end
emit(doc, prefix)
'

WT_DUMP_PY='
import re, sys, yaml
file, prefix = sys.argv[1], sys.argv[2]
with open(file) as f:
    doc = yaml.safe_load(f) or {}
q = chr(39)
def shq(v):
    return q + str(v).replace(q, q + chr(92) + q + q) + q
def san(k):
    return re.sub("[^A-Za-z0-9]", "_", str(k))
def emit(n, var):
    if isinstance(n, dict):
        if n:
            print(var + "__keys=" + shq(chr(10).join(str(k) for k in n)))
        for k, v in n.items():
            emit(v, var + "_" + san(k))
    elif isinstance(n, list):
        print(var + "__len=" + str(len(n)))
        for i, v in enumerate(n):
            emit(v, var + "_" + str(i))
    elif n is None:
        pass
    elif n is True:
        print(var + "=" + shq("true"))
    elif n is False:
        print(var + "=" + shq("false"))
    else:
        print(var + "=" + shq(n))
emit(doc, prefix)
'

yq_dump() { # <file> <prefix>
  P="$2" yq -r --from-file /dev/stdin "$1" <<'EOF'
(
  .. | select(tag == "!!map" and length > 0) |
    ([strenv(P)] + (path | map(tostring) | map(sub("[^A-Za-z0-9]", "_"))) | join("_"))
    + "__keys=" + ((keys | map(tostring) | join("\n")) | "'" + sub("'", "'\\''") + "'")
),
(
  .. | select(tag == "!!seq") |
    ([strenv(P)] + (path | map(tostring) | map(sub("[^A-Za-z0-9]", "_"))) | join("_"))
    + "__len=" + (length | tostring)
),
(
  .. | select(tag != "!!map" and tag != "!!seq" and tag != "!!null") |
    ([strenv(P)] + (path | map(tostring) | map(sub("[^A-Za-z0-9]", "_"))) | join("_"))
    + "=" + (tostring | "'" + sub("'", "'\\''") + "'")
)
EOF
}

dump_config() { # <file> <prefix>
  case "$YAML_BACKEND" in
    yq)     yq_dump "$1" "$2" ;;
    ruby)   ruby -e "$WT_DUMP_RB" "$1" "$2" ;;
    python) python3 -c "$WT_DUMP_PY" "$1" "$2" ;;
  esac
}

# ---------- config cache ----------
# Both YAML files are flattened once into $STATE_DIR/config.cache (WT_CFG_*
# for worktree-kit.yml, WT_LCFG_* for the .local variant) and sourced. The
# cache header records a cksum signature of the file contents; any content
# change, the local file appearing or disappearing, or a format bump makes
# the header mismatch and triggers a rebuild. (Checksums, not mtimes:
# BusyBox test -nt only has whole-second granularity.) Deleting the cache
# file also forces a rebuild.

load_config() {
  [ -n "${WT_CFG_SRC:-}" ] && return 0
  _cache="$STATE_DIR/config.cache"
  _hl=0; [ -f "$LOCAL_CONFIG" ] && _hl=1
  _sig="$(cksum < "$CONFIG")"
  [ "$_hl" = 1 ] && _sig="$_sig local $(cksum < "$LOCAL_CONFIG")"
  _want="# wt-cache 1 $_sig"
  if [ -f "$_cache" ]; then
    IFS= read -r _first < "$_cache" || _first=""
    if [ "$_first" = "$_want" ]; then
      . "$_cache"
      WT_CFG_SRC=hit
      return 0
    fi
  fi
  yaml_backend
  [ -n "$YAML_BACKEND" ] || die "needs a YAML reader: yq, ruby, or python3 with PyYAML"
  if ! {
    echo "$_want" &&
    dump_config "$CONFIG" WT_CFG &&
    { [ "$_hl" = 0 ] || dump_config "$LOCAL_CONFIG" WT_LCFG; }
  } > "$_cache.$$"; then
    rm -f "$_cache.$$"
    _bad="$CONFIG"; [ "$_hl" = 1 ] && _bad="$_bad (or $LOCAL_CONFIG)"
    die "could not parse $_bad — check the YAML"
  fi
  mv "$_cache.$$" "$_cache"
  . "$_cache"
  WT_CFG_SRC=rebuilt
}

# ---------- config lookups (pure shell over the sourced cache) ----------

cfg_var() { # dotted.path -> $CV: dots become _, matching the dumpers
  CV=""; _in="$1"
  while :; do case "$_in" in
    *.*) CV="$CV${_in%%.*}_"; _in="${_in#*.}" ;;
    *)   CV="$CV$_in"; break ;;
  esac; done
}

cfg_get() { # <dotted.path> [default] — scalar; default when absent or null
  cfg_var "$1"; _d="${2:-}"
  eval "printf '%s\n' \"\${WT_CFG_$CV-\$_d}\""
}

cfg_list() { # <dotted.path> — list items, one per line
  cfg_var "$1"
  eval "_n=\${WT_CFG_${CV}__len-0}"
  _i=0
  while [ "$_i" -lt "$_n" ]; do
    eval "printf '%s\n' \"\${WT_CFG_${CV}_$_i-}\""
    _i=$((_i + 1))
  done
}

cfg_map() { # <dotted.path> — KEY=VALUE per line (env-style keys only)
  cfg_var "$1"
  eval "_ks=\${WT_CFG_${CV}__keys-}"
  [ -n "$_ks" ] || return 0
  printf '%s\n' "$_ks" | while IFS= read -r _k; do
    case "$_k" in ''|*[!A-Za-z0-9_]*) continue ;; esac
    eval "printf '%s=%s\n' \"\$_k\" \"\${WT_CFG_${CV}_$_k-}\""
  done
}

cfg_pairs() { # <dotted.path> <key1> <key2> — "v1:v2" per line for hash lists
  cfg_var "$1"; _b="WT_CFG_$CV"
  eval "_n=\${${_b}__len-0}"
  _i=0
  while [ "$_i" -lt "$_n" ]; do
    eval "printf '%s:%s\n' \"\${${_b}_${_i}_$2-}\" \"\${${_b}_${_i}_$3-}\""
    _i=$((_i + 1))
  done
}

local_get() { # <dotted.path> [default] — worktree-kit.local.yml lookup
  cfg_var "$1"; _d="${2:-}"
  eval "printf '%s\n' \"\${WT_LCFG_$CV-\$_d}\""
}

expand() {
  printf '%s' "$1" | sed \
    -e "s|{slug}|$SLUG|g" -e "s|{n}|$N|g" -e "s|{port}|${PORT:-}|g" \
    -e "s|{container_port}|$CONTAINER_PORT|g" -e "s|{project}|$PROJECT|g"
}

worktree_paths() { git worktree list --porcelain | awk '/^worktree /{print $2}'; }

# ---------- lifecycle ----------

TAB="$(printf '\t')"

resolve_trunk() { # prints the trunk branch name, or empty
  _t=""
  if [ "${HAS_CONFIG:-0}" = 1 ]; then
    _t="$(local_get worktrees.trunk "")"
    if [ -z "$_t" ]; then _t="$(cfg_get worktrees.trunk "")"; fi
  fi
  if [ -z "$_t" ]; then
    _t="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')" || _t=""
  fi
  if [ -z "$_t" ]; then
    if git show-ref --verify --quiet refs/heads/main; then
      _t=main
    elif git show-ref --verify --quiet refs/heads/master; then
      _t=master
    fi
  fi
  printf '%s\n' "$_t"
}

worktree_for_branch() { # <branch> -> path, or empty. Always exits 0.
  git worktree list --porcelain | awk -v b="refs/heads/$1" '
    /^worktree /{ p = $2 }
    $1 == "branch" && $2 == b { print p; exit }
  '
  true
}

# One TAB-separated row per worktree: branch, slug, status, server, iso, path.
# wt list and the picker both read this, so they cannot drift.
worktree_rows() {
  _trunk="$(resolve_trunk)"
  git worktree list --porcelain | awk '
    /^worktree /  { p = $2 }
    /^branch /    { b = $2; sub("refs/heads/", "", b); print p "\t" b }
    /^detached/   { print p "\t(detached)" }
  ' | while IFS="$TAB" read -r _p _b; do
    _s="$(slugify "$_p")"

    _st=clean
    if [ -n "$(git -C "$_p" status --porcelain 2>/dev/null)" ]; then _st=dirty; fi
    if [ -n "$_trunk" ] && git -C "$_p" rev-parse --verify --quiet "$_trunk" >/dev/null 2>&1; then
      _c="$(git -C "$_p" rev-list --left-right --count "$_trunk...HEAD" 2>/dev/null || printf '0\t0')"
      _behind="$(printf '%s' "$_c" | cut -f1)"
      _ahead="$(printf '%s' "$_c" | cut -f2)"
      if [ "${_ahead:-0}"  -gt 0 ]; then _st="$_st +$_ahead"; fi
      if [ "${_behind:-0}" -gt 0 ]; then _st="$_st -$_behind"; fi
    fi

    _srv="-"; _iso="-"
    if [ "${HAS_CONFIG:-0}" = 1 ]; then
      if [ "$RUNNER" = compose ]; then
        _srv="$(docker ps --filter "label=wt.project=$PROJECT" --filter "label=wt.slug=$_s" \
                  --format '{{.Label "wt.port"}}' 2>/dev/null | head -1)"
        _iso="$(docker ps --filter "label=wt.project=$PROJECT" --filter "label=wt.slug=$_s" \
                  --format '{{.Label "wt.isolation"}}' 2>/dev/null | head -1)"
      elif [ -f "$STATE_DIR/$_s.pid" ]; then
        _srv="$(cat "$STATE_DIR/$_s.port" 2>/dev/null || echo '?')"
      fi
    fi
    if [ -n "$_srv" ] && [ "$_srv" != "-" ]; then _srv=":$_srv"; else _srv="-"; fi
    if [ -z "$_iso" ]; then _iso="-"; fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$_b" "$_s" "$_st" "$_srv" "$_iso" "$_p"
  done
  true
}

sanitize_branch() { # <branch> -> filesystem-safe
  printf '%s' "$1" | tr -c 'A-Za-z0-9._' '_'
}

path_template() {
  _t=""
  if [ "${HAS_CONFIG:-0}" = 1 ]; then
    _t="$(local_get worktrees.path "")"
    if [ -z "$_t" ]; then _t="$(cfg_get worktrees.path "")"; fi
  fi
  if [ -z "$_t" ]; then _t='{parent}/{repo}-worktrees/{branch}'; fi
  printf '%s\n' "$_t"
}

# {branch_raw} MUST be substituted before {branch}, or the longer token is
# eaten by the shorter one and leaves a stray "_raw".
expand_path() { # <template> <raw-branch>
  _pb="$(sanitize_branch "$2")"
  _pp="$(dirname "$PRIMARY")"
  _pr="$(basename "$PRIMARY")"
  printf '%s' "$1" | sed \
    -e "s|{branch_raw}|$2|g" \
    -e "s|{parent}|$_pp|g" \
    -e "s|{repo}|$_pr|g" \
    -e "s|{branch}|$_pb|g" \
    -e "s|{home}|$HOME|g"
}

# stdout is the cd channel: a path, and nothing else.
emit_cd() { # <path>
  printf '%s\n' "$1"
  if [ -z "${WT_SHELL_INTEGRATION:-}" ]; then
    note "not cd'd — install shell integration: eval \"\$(wt shell-init zsh)\""
  fi
}

# Prints the selected worktree path. fzf draws on /dev/tty and prints only
# the selection to stdout, so it composes with the cd channel.
pick_worktree() {
  _rows="$(worktree_rows)"
  if [ -z "$_rows" ]; then die "no worktrees"; fi

  if command -v fzf >/dev/null 2>&1; then
    _sel="$(printf '%s\n' "$_rows" | fzf \
      --delimiter="$TAB" --with-nth=1,2,3,4 \
      --preview 'git -C {6} log --oneline -10; echo; git -C {6} status -s' \
      --preview-window=right:60%)" || return 1
  else
    _tmp="$STATE_DIR/.picker.$$"
    printf '%s\n' "$_rows" > "$_tmp"
    _i=0
    while IFS="$TAB" read -r _b _s _st _srv _iso _p; do
      _i=$((_i + 1))
      printf '%2d) %-28s %s\n' "$_i" "$_b" "$_p" >&2
    done < "$_tmp"
    printf 'select worktree [1-%d]: ' "$_i" >&2
    if ! read -r _n < /dev/tty; then rm -f "$_tmp"; return 1; fi
    case "$_n" in
      ''|*[!0-9]*) rm -f "$_tmp"; die "not a number: $_n" ;;
    esac
    if [ "$_n" -lt 1 ] || [ "$_n" -gt "$_i" ]; then rm -f "$_tmp"; die "out of range: $_n"; fi
    _sel="$(sed -n "${_n}p" "$_tmp")"
    rm -f "$_tmp"
  fi

  printf '%s' "$_sel" | cut -f6
}

# Reclaims everything the kit provisioned for a slug. Does NOT touch the
# worktree directory or the branch. Overlays under $OVERLAY_DIR are per-file
# and personal, never per-worktree — they are deliberately left alone.
teardown_worktree() { # <slug> <path>
  _ts="$1"; _tp="$2"

  if [ "${HAS_CONFIG:-0}" = 1 ]; then
    "$0" down "$_ts" >&2 || note "could not stop the server for $_ts — check for a stray process"

    # expand() reads the globals SLUG and N; borrow them for the target slug
    _old_slug="$SLUG"; _old_n="$N"
    SLUG="$_ts"; N=$(( $(hashnum "$_ts") % 15 + 1 ))

    if [ -f "$STATE_DIR/$_ts.dbready" ]; then
      if [ -f "$STATE_DIR/$_ts.dbowned" ]; then
        _drop="$(cfg_get isolation.db_drop "")"
        if [ -n "$_drop" ]; then
          note "dropping database for $_ts"
          runner_exec own_db "$(expand "$_drop")" >&2 || note "db_drop failed — the database may remain"
        else
          note "no isolation.db_drop configured — the database for slug $_ts is left in place"
        fi
      else
        note "database for slug $_ts was adopted, not created by wt — leaving it in place"
      fi
    fi

    _flush="$(cfg_get isolation.redis_flush "")"
    if [ -n "$_flush" ]; then
      note "flushing redis db $N for $_ts"
      runner_exec isolated "$(expand "$_flush")" >&2 || note "redis_flush failed — db $N may still hold keys"
    else
      note "no isolation.redis_flush configured — redis db $N is left as is"
    fi

    SLUG="$_old_slug"; N="$_old_n"
  fi

  rm -f "$STATE_DIR/$_ts.pid" "$STATE_DIR/$_ts.port" \
        "$STATE_DIR/$_ts.dbready" "$STATE_DIR/$_ts.dbowned" "$STATE_DIR/logs/$_ts.log"
  true
}

remove_worktree_and_branch() { # <branch> <path> <keep_branch 0|1> <force 0|1>
  if [ "$4" = 1 ]; then
    git worktree remove --force "$2" >&2
  else
    git worktree remove "$2" >&2
  fi
  if [ "$3" = 0 ]; then
    if [ "$4" = 1 ]; then
      git branch -D "$1" >&2
    else
      git branch -d "$1" >&2
    fi
  fi
  true
}

confirm() { # <prompt> — 0 on yes, reading stdin
  printf '%s [y/N] ' "$1" >&2
  read -r _ans || _ans=n
  case "$_ans" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

# ---------- ports ----------

# lsof (macOS) -> ss (Linux) -> bind probe via ruby/python3 -> assume free.
# BusyBox's lsof applet ignores flags and always exits 0 — skip it.
port_free() {
  if command -v lsof >/dev/null 2>&1 && ! lsof -h 2>&1 | grep -qi busybox; then
    ! lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
  elif command -v ss >/dev/null 2>&1; then
    ! ss -ltn 2>/dev/null | awk '{print $4}' | grep -q ":$1\$"
  elif command -v ruby >/dev/null 2>&1; then
    ruby -rsocket -e 'TCPServer.new("127.0.0.1", ARGV[0].to_i).close' "$1" 2>/dev/null
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import socket,sys; s=socket.socket(); s.bind(("127.0.0.1",int(sys.argv[1]))); s.close()' "$1" 2>/dev/null
  else
    return 0
  fi
}

pick_port() {
  pin="$(local_get "servers.$SLUG.port" "")"
  if [ -n "$pin" ]; then echo "$pin"; return; fi
  p=$(( 3000 + $(hashnum "$SLUG") % 900 ))
  while ! port_free "$p"; do p=$((p + 1)); done
  echo "$p"
}

# ---------- isolation ----------

# shared: nothing. isolated: isolated_env. own_db: isolated_env + own_db_env.
detect_isolation() {
  pin="$(local_get "servers.$SLUG.isolation" "" | tr - _)"
  if [ -n "$pin" ]; then echo "$pin"; return; fi
  [ "$WT_PATH" = "$PRIMARY" ] && { echo shared; return; }
  for mp in $(cfg_list isolation.migration_paths); do
    [ -d "$WT_PATH/$mp" ] || continue
    for f in "$WT_PATH/$mp"/*; do
      [ -e "$f" ] || continue
      [ -e "$PRIMARY/$mp/$(basename "$f")" ] || { echo own_db; return; }
    done
  done
  echo isolated
}

iso_env_list() { # prints expanded KEY=VALUE lines for isolation level $1
  lvl="$1"
  if [ "$lvl" = isolated ] || [ "$lvl" = own_db ]; then
    cfg_map isolation.isolated_env | while IFS= read -r kv; do
      [ -n "$kv" ] && expand "$kv" && echo
    done
  fi
  if [ "$lvl" = own_db ]; then
    cfg_map isolation.own_db_env | while IFS= read -r kv; do
      [ -n "$kv" ] && expand "$kv" && echo
    done
  fi
  true
}

ensure_own_db() {
  marker="$STATE_DIR/$SLUG.dbready"
  [ -f "$marker" ] && return 0
  check="$(cfg_get isolation.db_check "")"
  if [ -n "$check" ] && runner_exec own_db "$(expand "$check")" >/dev/null 2>&1; then
    touch "$marker"; return 0
  fi
  boot="$(cfg_get isolation.db_bootstrap "")"
  [ -n "$boot" ] || die "own-db needs isolation.db_bootstrap in worktree-kit.yml"
  note "bootstrapping isolated database for $SLUG ..."
  runner_exec own_db "$(expand "$boot")"
  # .dbowned records that the kit itself created this database (as opposed
  # to the db_check branch above, which only found one already there) — wt
  # rm/merge must never drop a database they did not create.
  touch "$marker" "$STATE_DIR/$SLUG.dbowned"
}

# ---------- compose runner ----------

compose_args() { # mounts + volumes + env for isolation level $1
  a="-v $WT_PATH:$WORKDIR -v $GIT_COMMON:$GIT_COMMON:ro"
  for d in $(cfg_list mounts.read_only); do
    [ -n "$d" ] && [ -e "$PRIMARY/$d" ] && a="$a -v $PRIMARY/$d:$WORKDIR/$d:ro"
  done
  if [ -d "$OVERLAY_DIR" ]; then
    for f in $(cd "$OVERLAY_DIR" && find . -type f | sed 's|^\./||'); do
      a="$a -v $OVERLAY_DIR/$f:$WORKDIR/$f:ro"
    done
  fi
  for v in $(cfg_pairs volumes name path); do
    name="$(expand "${v%%:*}")"
    docker volume create "$name" >/dev/null
    a="$a -v $name:${v#*:}"
  done
  for kv in $(iso_env_list "$1"); do a="$a -e $kv"; done
  echo "$a"
}

runner_exec() { # $1 = isolation level, $2 = shell string to run in the worktree
  if [ "$RUNNER" = compose ]; then
    cd "$PRIMARY"
    docker compose run --rm --no-deps -T $(compose_args "$1") "$SERVICE" \
      sh -c "${PREPARE:-:}; $2"
  else
    envs="$(iso_env_list "$1" | tr '\n' ' ')"
    ( cd "$WT_PATH" && env $envs sh -c "${PREPARE:-:}; $2" )
  fi
}

# ---------- commands ----------

cmd_run() {
  require_config
  LEVEL=shared
  while [ $# -gt 0 ]; do case "$1" in
    --isolated) LEVEL=isolated; shift ;;
    --own-db) LEVEL=own_db; shift ;;
    --shared) LEVEL=shared; shift ;;
    --) shift; break ;;
    *) break ;;
  esac; done
  [ $# -gt 0 ] || die "usage: wt run [--shared|--isolated|--own-db] <command...>"
  [ "$LEVEL" = own_db ] && ensure_own_db
  if [ "$RUNNER" = compose ]; then
    cd "$PRIMARY"
    T=""; [ -t 1 ] || T="-T"
    exec docker compose run --rm --no-deps $T $(compose_args "$LEVEL") "$SERVICE" \
      sh -c "${PREPARE:-:}; exec \"\$@\"" sh "$@"
  else
    envs="$(iso_env_list "$LEVEL" | tr '\n' ' ')"
    cd "$WT_PATH"
    [ -n "${PREPARE:-}" ] && sh -c "$PREPARE"
    exec env $envs "$@"
  fi
}

cmd_server() {
  require_config
  LEVEL=""
  while [ $# -gt 0 ]; do case "$1" in
    --isolated) LEVEL=isolated; shift ;;
    --own-db) LEVEL=own_db; shift ;;
    --shared) LEVEL=shared; shift ;;
    *) break ;;
  esac; done
  [ -n "$SERVER_CMD" ] || die "no hooks.server in worktree-kit.yml"
  [ -n "$LEVEL" ] || LEVEL="$(detect_isolation)"
  PORT="${1:-$(pick_port)}"
  port_free "$PORT" || die "port $PORT is busy"
  [ "$LEVEL" = own_db ] && ensure_own_db
  cmd="${PREPARE:+$(expand "$PREPARE") && }${BUILD:+$(expand "$BUILD") && }$(expand "$SERVER_CMD")"
  if [ "$RUNNER" = compose ]; then
    name="wt-$PROJECT-$SLUG"
    old="$(docker ps -aq --filter "name=^/$name$")"
    if [ -n "$old" ]; then
      docker ps -q --filter "name=^/$name$" | grep -q . && die "$SLUG already running — wt down $SLUG first"
      docker rm "$old" >/dev/null
    fi
    cd "$PRIMARY"
    docker compose run -d --rm --no-deps --name "$name" \
      -l "wt.project=$PROJECT" -l "wt.slug=$SLUG" -l "wt.port=$PORT" -l "wt.isolation=$LEVEL" \
      -p "$PORT:$CONTAINER_PORT" $(compose_args "$LEVEL") "$SERVICE" sh -c "$cmd" >/dev/null
    note "$SLUG [$LEVEL] -> http://localhost:$PORT  (logs: wt logs $SLUG)"
  else
    pidfile="$STATE_DIR/$SLUG.pid"
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
      die "$SLUG already running — wt down $SLUG first"
    fi
    envs="$(iso_env_list "$LEVEL" | tr '\n' ' ')"
    log="$STATE_DIR/logs/$SLUG.log"
    # The server gets its own process group so wt down can kill the whole
    # tree (sh -c wrapper, server, its children) — killing only the pidfile
    # pid used to orphan the server and leave the port occupied. setsid
    # exists on Linux/BusyBox; macOS has none but its bash honors set -m.
    (
      cd "$WT_PATH" || exit 1
      if command -v setsid >/dev/null 2>&1; then
        env $envs nohup setsid sh -c "$cmd" > "$log" 2>&1 &
      else
        set -m 2>/dev/null || :
        env $envs nohup sh -c "$cmd" > "$log" 2>&1 &
      fi
      echo $! > "$pidfile"
    )
    echo "$PORT" > "$STATE_DIR/$SLUG.port"
    note "$SLUG [$LEVEL] -> http://localhost:$PORT  (pid $(cat "$pidfile"), logs: wt logs $SLUG)"
  fi
}

cmd_up() {
  LEVEL=""
  while [ $# -gt 0 ]; do case "$1" in
    --isolated|--own-db|--shared) LEVEL="$1"; shift ;;
    *) break ;;
  esac; done
  for p in $(worktree_paths); do
    [ "$p" = "$PRIMARY" ] && continue
    s="$(slugify "$p")"
    if [ $# -gt 0 ]; then
      echo " $* " | grep -q " $s " || continue
    fi
    ( cd "$p" && "$0" server $LEVEL ) || note "failed to start $s"
  done
}

cmd_down() {
  require_config
  if [ "$RUNNER" = compose ]; then
    if [ $# -gt 0 ]; then
      for s in "$@"; do
        docker ps -q --filter "label=wt.project=$PROJECT" --filter "label=wt.slug=$s" | xargs -r docker stop >/dev/null
        note "stopped $s"
      done
    else
      docker ps -q --filter "label=wt.project=$PROJECT" | xargs -r docker stop >/dev/null
      note "stopped all $PROJECT worktree servers"
    fi
  else
    for f in "$STATE_DIR"/*.pid; do
      [ -e "$f" ] || continue
      s="$(basename "$f" .pid)"
      if [ $# -gt 0 ]; then echo " $* " | grep -q " $s " || continue; fi
      pid="$(cat "$f")"
      # the pid is a process-group leader (see cmd_server); kill the whole
      # group, falling back to the bare pid for pre-group pidfiles
      kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
      rm -f "$f" "$STATE_DIR/$s.port"; note "stopped $s"
    done
  fi
}

cmd_ps() {
  require_config
  if [ "$RUNNER" = compose ]; then
    docker ps --filter "label=wt.project=$PROJECT" \
      --format 'table {{.Label "wt.slug"}}\t{{.Label "wt.isolation"}}\thttp://localhost:{{.Label "wt.port"}}\t{{.Status}}'
  else
    printf 'SLUG\tURL\tPID\tSTATE\n'
    for f in "$STATE_DIR"/*.pid; do
      [ -e "$f" ] || continue
      s="$(basename "$f" .pid)"
      pid="$(cat "$f")"
      st=dead; kill -0 "$pid" 2>/dev/null && st=running
      prt="$(cat "$STATE_DIR/$s.port" 2>/dev/null || echo '?')"
      printf '%s\thttp://localhost:%s\t%s\t%s\n' "$s" "$prt" "$pid" "$st"
    done
  fi
}

cmd_logs() {
  require_config
  s="${1:-$SLUG}"
  if [ "$RUNNER" = compose ]; then
    exec docker logs -f "wt-$PROJECT-$s"
  else
    [ -f "$STATE_DIR/logs/$s.log" ] || die "no logs for $s — was it ever started here?"
    exec tail -f "$STATE_DIR/logs/$s.log"
  fi
}

cmd_localize() {
  case "${1:-}" in
    --list) if [ -d "$OVERLAY_DIR" ]; then cd "$OVERLAY_DIR" && find . -type f | sed 's|^\./||'; fi; return 0 ;;
    --remove) shift; for p in "$@"; do
        if [ -f "$OVERLAY_DIR/$p" ]; then rm -f "$OVERLAY_DIR/$p"; note "removed overlay: $p"
        else note "no overlay: $p"; fi
      done; return ;;
    '') die "usage: wt localize <tracked-file>... | --list | --remove <file>..." ;;
  esac
  for p in "$@"; do
    [ -f "$PRIMARY/$p" ] || die "no such file in primary checkout: $p"
    mkdir -p "$OVERLAY_DIR/$(dirname "$p")"
    cp "$PRIMARY/$p" "$OVERLAY_DIR/$p"
    note "localized: $p"
  done
}

cmd_reset() {
  s="${1:-$SLUG}"
  rm -f "$STATE_DIR/$s.dbready" "$STATE_DIR/$s.dbowned"
  note "cleared db-bootstrap marker for $s (next own-db run re-bootstraps)"
}

cmd_init() {
  [ -f "$CONFIG" ] && die "worktree-kit.yml already exists at $PRIMARY"
  # resolve symlink chains; relative targets (Homebrew, npm) resolve against the link's dir
  self="$0"
  while [ -L "$self" ]; do
    link="$(readlink "$self")"
    case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
  done
  kit="$(cd "$(dirname "$self")/.." && pwd)"
  t=""
  [ -f "$PRIMARY/Gemfile" ] && t=rails
  # artisan before package.json: Laravel repos also carry a package.json
  [ -z "$t" ] && [ -f "$PRIMARY/artisan" ] && t=laravel
  [ -z "$t" ] && [ -f "$PRIMARY/package.json" ] && t=node
  [ -z "$t" ] && [ -f "$PRIMARY/manage.py" ] && t=django
  [ -z "$t" ] && [ -f "$PRIMARY/go.mod" ] && t=go
  [ -n "$t" ] || die "could not detect stack — copy a template from $kit/templates/ yourself"
  r=host
  for c in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
    if [ -f "$PRIMARY/$c" ]; then r=compose; break; fi
  done
  cp "$kit/templates/$r/$t.yml" "$CONFIG"
  note "wrote $CONFIG from the $r/$t template — edit it, then try 'wt server'"
}

cmd_doctor() {
  echo "wt $WT_VERSION"
  echo "primary:   $PRIMARY"
  echo "worktree:  $WT_PATH (slug: $SLUG, n: $N)"
  if [ -f "$CONFIG" ]; then require_config; echo "config:    $CONFIG (runner: $RUNNER, cache: $WT_CFG_SRC)"; else echo "config:    MISSING — run wt init"; fi
  yaml_backend
  case "$YAML_BACKEND" in
    yq)     echo "yaml:      $(yq --version)" ;;
    ruby)   echo "yaml:      ruby $(ruby -e 'print RUBY_VERSION') (yq not needed)" ;;
    python) echo "yaml:      python3 + PyYAML (yq not needed)" ;;
    '')     echo "yaml:      NONE — ok while the config cache is fresh; config edits need yq, ruby, or python3+PyYAML" ;;
  esac
  [ "${RUNNER:-compose}" = compose ] && { docker info >/dev/null 2>&1 && echo "docker:    up" || echo "docker:    DOWN"; }
  if [ -d "$OVERLAY_DIR" ]; then
    for f in $(cd "$OVERLAY_DIR" && find . -type f | sed 's|^\./||'); do
      [ "$PRIMARY/$f" -nt "$OVERLAY_DIR/$f" ] && echo "STALE overlay: $f (source is newer — wt localize $f)"
    done
  fi
  echo "ok"
}

cmd_new() {
  load_config_soft
  _base=""; _start_server=0; _branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)   _base="${2:-}"; [ -n "$_base" ] || die "--from needs a branch or commit"; shift 2 ;;
      --server) _start_server=1; shift ;;
      -*)       die "unknown flag: $1 (wt new <branch> [--from <base>] [--server])" ;;
      *)        _branch="$1"; shift ;;
    esac
  done
  [ -n "$_branch" ] || die "usage: wt new <branch> [--from <base>] [--server]"

  _existing="$(worktree_for_branch "$_branch")"
  if [ -n "$_existing" ]; then
    die "branch $_branch already has a worktree at $_existing — use: wt switch $_branch"
  fi

  _path="$(expand_path "$(path_template)" "$_branch")"
  case "$_path" in
    *" "*) die "worktrees.path expands to a path containing a space:
  $_path
wt splits unquoted strings when building compose args and host env lists, so
worktree paths must be space-free. Change worktrees.path or the branch name." ;;
  esac
  if [ -e "$_path" ]; then die "$_path already exists"; fi

  mkdir -p "$(dirname "$_path")"
  if git show-ref --verify --quiet "refs/heads/$_branch"; then
    note "adopting existing branch $_branch"
    git worktree add "$_path" "$_branch" >&2
  elif [ -n "$_base" ]; then
    git worktree add -b "$_branch" "$_path" "$_base" >&2
  else
    git worktree add -b "$_branch" "$_path" >&2
  fi

  # The prepare hook must run exactly once. `wt run` already runs
  # hooks.prepare itself before execing its payload, so the payload here is
  # inert (`true`) — passing the hook again as the payload would run it
  # twice. When --server is requested, skip this step entirely: `wt server`
  # runs hooks.prepare as part of its own command string, so running it
  # here too would make it run twice for the bare case and three times
  # once the server path also fires it.
  if [ "$_start_server" = 0 ] && [ "$HAS_CONFIG" = 1 ] && [ -n "${PREPARE:-}" ]; then
    note "prepare: $PREPARE"
    if ! ( cd "$_path" && "$0" run --shared -- true ) >&2; then
      die "prepare hook failed — worktree left at $_path"
    fi
  fi

  if [ "$_start_server" = 1 ]; then
    if [ "$HAS_CONFIG" = 0 ]; then die "--server needs worktree-kit.yml — run 'wt init'"; fi
    ( cd "$_path" && "$0" server ) >&2 || die "server failed to start in $_path"
  fi

  emit_cd "$_path"
}

cmd_list() {
  load_config_soft
  _all=0
  for _a in "$@"; do
    case "$_a" in
      --all) _all=1 ;;
      *)     die "unknown flag: $_a (wt list [--all])" ;;
    esac
  done

  _out="BRANCH${TAB}SLUG${TAB}STATUS${TAB}SERVER${TAB}ISO${TAB}PATH
$(worktree_rows)"

  if [ "$_all" = 1 ]; then
    for _b in $(git for-each-ref --format='%(refname:short)' refs/heads); do
      if [ -z "$(worktree_for_branch "$_b")" ]; then
        _out="$_out
$_b${TAB}-${TAB}(no worktree)${TAB}-${TAB}-${TAB}-"
      fi
    done
  fi

  if command -v column >/dev/null 2>&1; then
    printf '%s\n' "$_out" | column -t -s "$TAB"
  else
    printf '%s\n' "$_out"
  fi
}

cmd_switch() {
  load_config_soft
  if [ $# -eq 0 ]; then
    _p="$(pick_worktree)" || exit 1
    if [ -z "$_p" ]; then exit 1; fi
    emit_cd "$_p"
    return 0
  fi

  _p="$(worktree_for_branch "$1")"
  if [ -z "$_p" ]; then
    if git show-ref --verify --quiet "refs/heads/$1"; then
      die "branch $1 has no worktree — create one: wt new $1"
    fi
    die "no worktree or branch named $1 (see: wt list --all)"
  fi
  emit_cd "$_p"
}

cmd_rm() {
  load_config_soft
  _force=0; _keep=0; _branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force)    _force=1; shift ;;
      --keep-branch) _keep=1; shift ;;
      -*)            die "unknown flag: $1 (wt rm [<branch>] [--keep-branch] [--force])" ;;
      *)             _branch="$1"; shift ;;
    esac
  done
  if [ -z "$_branch" ]; then _branch="$(git rev-parse --abbrev-ref HEAD)"; fi

  _path="$(worktree_for_branch "$_branch")"
  if [ -z "$_path" ]; then die "no worktree for branch $_branch (see: wt list)"; fi
  if [ "$_path" = "$PRIMARY" ]; then die "refusing to remove the primary checkout at $PRIMARY"; fi

  if [ "$_force" = 0 ]; then
    if [ -n "$(git -C "$_path" status --porcelain)" ]; then
      die "$_branch has uncommitted changes — commit them, or use --force"
    fi
    # Deliberately reachability, not "unpushed": a local-only branch has no
    # upstream, so an unpushed test would refuse every agent worktree.
    _trunk="$(resolve_trunk)"
    if [ -n "$_trunk" ]; then
      # A configured worktrees.trunk is returned as-is, unverified — it can
      # name a ref this worktree cannot resolve (e.g. a remote-only branch).
      # "cannot check" must never be treated as "nothing unmerged" for a
      # destructive command, so require the ref to resolve before counting.
      if ! git -C "$_path" rev-parse --verify --quiet "$_trunk" >/dev/null 2>&1; then
        die "cannot verify $_branch is merged — $_trunk not found in this worktree, use --force"
      fi
      _un="$(git -C "$_path" rev-list --count "$_trunk..$_branch" 2>/dev/null || echo 0)"
      if [ "$_un" -gt 0 ]; then
        die "$_branch has $_un commit(s) not in $_trunk — merge them (wt merge $_branch), or use --force"
      fi
    fi
  fi

  _slug="$(slugify "$_path")"
  note "about to remove:"
  note "  worktree  $_path"
  if [ "$_keep" = 0 ]; then note "  branch    $_branch"; fi
  note "  state     $STATE_DIR/$_slug.*"
  if [ "${HAS_CONFIG:-0}" = 1 ] && [ -f "$STATE_DIR/$_slug.dbready" ]; then
    note "  database  provisioned for slug $_slug"
  fi
  if [ "$_force" = 0 ]; then
    confirm "proceed?" || die "aborted"
  fi

  _removed_cwd=0
  # git worktree remove deletes the cwd out from under this process when we
  # are inside it; the very next git call (branch -d/-D) then fails calling
  # getcwd() ("Unable to read current working directory") and set -e kills
  # cmd_rm before the branch is deleted or emit_cd runs. Step out first.
  # runner_exec keys off $WT_PATH (a fixed global), not the live cwd, so
  # this does not retarget teardown_worktree's own_db/redis work.
  if [ "$WT_PATH" = "$_path" ]; then _removed_cwd=1; cd "$PRIMARY"; fi

  teardown_worktree "$_slug" "$_path"
  remove_worktree_and_branch "$_branch" "$_path" "$_keep" "$_force"
  note "removed $_branch"

  if [ "$_removed_cwd" = 1 ]; then emit_cd "$PRIMARY"; fi
}

cmd_merge() {
  load_config_soft
  _trunk=""; _msg=""; _no_remove=0; _force=0; _branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --into)      _trunk="${2:-}"; [ -n "$_trunk" ] || die "--into needs a branch"; shift 2 ;;
      -m)          _msg="${2:-}";   [ -n "$_msg" ]   || die "-m needs a message";   shift 2 ;;
      --no-remove) _no_remove=1; shift ;;
      -f|--force)  _force=1; shift ;;
      -*)          die "unknown flag: $1 (wt merge [<branch>] [--into <trunk>] [--no-remove] [-m <msg>] [--force])" ;;
      *)           _branch="$1"; shift ;;
    esac
  done
  if [ -z "$_branch" ]; then _branch="$(git rev-parse --abbrev-ref HEAD)"; fi

  _path="$(worktree_for_branch "$_branch")"
  if [ -z "$_path" ]; then die "no worktree for branch $_branch (see: wt list)"; fi
  if [ "$_path" = "$PRIMARY" ]; then die "refusing to merge the primary checkout's own branch"; fi

  if [ -z "$_trunk" ]; then _trunk="$(resolve_trunk)"; fi
  if [ -z "$_trunk" ]; then die "cannot determine trunk — pass --into <branch> or set worktrees.trunk"; fi
  if [ "$_trunk" = "$_branch" ]; then die "$_branch is the trunk"; fi

  # ---- guards, before anything is rewritten ----
  if [ -n "$(git -C "$_path" status --porcelain)" ]; then
    die "$_branch has uncommitted changes — commit or stash them first"
  fi
  _ahead="$(git -C "$_path" rev-list --count "$_trunk..$_branch" 2>/dev/null || echo 0)"
  if [ "$_ahead" -eq 0 ]; then die "$_branch has no commits ahead of $_trunk"; fi

  _primary_branch="$(git -C "$PRIMARY" rev-parse --abbrev-ref HEAD)"
  if [ "$_primary_branch" != "$_trunk" ]; then
    die "$_trunk is not checked out at $PRIMARY (found $_primary_branch)"
  fi
  if [ -n "$(git -C "$PRIMARY" status --porcelain)" ]; then
    die "the primary checkout at $PRIMARY is dirty — commit or stash first"
  fi
  if git -C "$_path" rev-parse --verify --quiet "$_branch@{upstream}" >/dev/null 2>&1; then
    if [ "$_force" = 0 ]; then
      die "$_branch has an upstream — squashing rewrites published history; pass --force to proceed"
    fi
  fi

  # ---- backup ref: the undo for everything below ----
  _slug="$(slugify "$_path")"
  _backup="refs/wt/premerge/$_slug"
  _orig="$(git -C "$_path" rev-parse HEAD)"
  git -C "$_path" update-ref "$_backup" "$_orig"
  note "backup: $_backup -> $_orig"

  # ---- squash ----
  _base="$(git -C "$_path" merge-base "$_trunk" "$_branch")"
  if [ -z "$_msg" ]; then
    _subj="$(git -C "$_path" log --format='%s' --reverse "$_base..$_branch" | head -1)"
    _body="$(git -C "$_path" log --format='%s' --reverse "$_base..$_branch" | tail -n +2)"
    if [ -n "$_body" ]; then
      _msg="$_subj

$_body"
    else
      _msg="$_subj"
    fi
  fi
  git -C "$_path" reset --soft "$_base" >&2
  if ! git -C "$_path" commit -q -m "$_msg" >&2; then
    git -C "$_path" reset --hard "$_orig" >&2
    die "squash commit failed — $_branch restored to $_orig"
  fi

  # ---- rebase ----
  if ! git -C "$_path" rebase "$_trunk" >&2; then
    git -C "$_path" rebase --abort >/dev/null 2>&1 || true
    git -C "$_path" reset --hard "$_orig" >&2
    die "rebase of $_branch onto $_trunk hit a conflict — $_branch restored to $_orig
resolve by hand:  git -C $_path rebase $_trunk"
  fi

  # ---- fast-forward trunk ----
  _trunk_before="$(git -C "$PRIMARY" rev-parse "$_trunk")"
  if ! git -C "$PRIMARY" merge --ff-only "$_branch" >&2; then
    git -C "$_path" reset --hard "$_orig" >&2
    die "$_trunk could not fast-forward to $_branch — it moved underneath us; $_branch restored to $_orig"
  fi
  note "merged $_branch into $_trunk"
  note "undo:   git -C $PRIMARY reset --hard $_trunk_before   (branch backup: $_backup)"

  # ---- teardown ----
  if [ "$_no_remove" = 1 ]; then return 0; fi

  _removed_cwd=0
  # git worktree remove deletes the cwd out from under this process when we
  # are inside it; the very next git call (branch -d/-D) then fails calling
  # getcwd() ("Unable to read current working directory") and set -e kills
  # cmd_merge before the branch is deleted or emit_cd runs. Step out first.
  # runner_exec keys off $WT_PATH (a fixed global), not the live cwd, so
  # this does not retarget teardown_worktree's own_db/redis work.
  if [ "$WT_PATH" = "$_path" ]; then _removed_cwd=1; cd "$PRIMARY"; fi
  teardown_worktree "$_slug" "$_path"
  remove_worktree_and_branch "$_branch" "$_path" 0 0
  if [ "$_removed_cwd" = 1 ]; then emit_cd "$PRIMARY"; fi
}

cmd_shell_init() {
  _kind="${1:-}"
  if [ -z "$_kind" ]; then _kind="$(basename "${SHELL:-sh}")"; fi
  case "$_kind" in
    bash|zsh)
      cat <<'EOF'
wt() {
  case "${1:-}" in
    switch|new|rm|merge)
      local __wt_d
      __wt_d="$(WT_SHELL_INTEGRATION=1 command wt "$@")" || return $?
      # explicit if, not &&: a command that prints no path must still return 0
      if [ -n "$__wt_d" ]; then cd "$__wt_d"; fi
      ;;
    *) command wt "$@" ;;
  esac
}
EOF
      ;;
    fish)
      cat <<'EOF'
function wt
  switch "$argv[1]"
    case switch new rm merge
      set -l __wt_d (WT_SHELL_INTEGRATION=1 command wt $argv)
      or return $status
      if test -n "$__wt_d"
        cd $__wt_d
      end
    case '*'
      command wt $argv
  end
end
EOF
      ;;
    *) die "unsupported shell: $_kind (bash, zsh, fish)" ;;
  esac
}

usage() {
  cat <<'EOF'
wt — worktree-aware runner (config: worktree-kit.yml at the primary checkout)

  wt run [--shared|--isolated|--own-db] [--] <cmd...>   one-off command in this worktree
  wt server [--shared|--isolated|--own-db] [port]       start this worktree's server (auto port + isolation)
  wt up [--shared|--isolated|--own-db] [slug...]        start servers for all (or named) worktrees
  wt down [slug...]      stop servers
  wt ps                  list running worktree servers
  wt logs [slug]         follow a server's logs
  wt localize <file...>  snapshot a personal overlay (--list / --remove)
  wt reset [slug]        clear the own-db bootstrap marker
  wt new <branch> [--from <base>] [--server]   create a branch + worktree
  wt switch [<branch>]   cd to a worktree; no argument opens a picker
  wt rm [<branch>] [--keep-branch] [--force]   tear down and remove a worktree
  wt merge [<branch>] [--into <trunk>] [-m <msg>] [--no-remove] [--force]
                         squash, rebase, fast-forward trunk, then tear down
  wt list [--all]        list worktrees (branch, slug, status, server, isolation)
  wt init                write worktree-kit.yml from a stack template
  wt doctor              environment + config checks
  wt shell-init [bash|zsh|fish]   emit the shell function that makes switch cd
EOF
}

# help/version must work outside a git repo — handle them before ctx_init
case "${1:-}" in
  -h|--help|help|'') usage; exit 0 ;;
  -v|--version) echo "wt $WT_VERSION"; exit 0 ;;
  shell-init) shift; cmd_shell_init "$@"; exit 0 ;;
esac

ctx_init
case "$1" in
  run) shift; cmd_run "$@" ;;
  server) shift; cmd_server "$@" ;;
  up) shift; cmd_up "$@" ;;
  down) shift; cmd_down "$@" ;;
  ps) shift; cmd_ps "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  localize) shift; cmd_localize "$@" ;;
  reset) shift; cmd_reset "$@" ;;
  new) shift; cmd_new "$@" ;;
  switch) shift; cmd_switch "$@" ;;
  rm) shift; cmd_rm "$@" ;;
  merge) shift; cmd_merge "$@" ;;
  list) shift; cmd_list "$@" ;;
  init) shift; cmd_init "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  *) die "unknown command: $1 (wt --help)" ;;
esac
